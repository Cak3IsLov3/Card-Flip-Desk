# Copy to .env and fill in. .env is in .gitignore: never commit real secrets.

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Required: Fernet key(s) for the eBay tokens, comma-separated (the first one encrypts). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# Database password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me

# Where the site is reached. Behind an HTTPS proxy set DJANGO_HTTPS=1 (secure cookies, redirect, HSTS).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://localhost:8000
WEB_PORT=8000
DJANGO_HTTPS=0

# Optional: SMTP for the weekly digest. Without EMAIL_HOST, emails go to the container log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional: eBay price advice (see README).
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
